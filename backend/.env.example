PORT=4000

# Supabase (Project Settings > API)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Accounts (Auth): the public "anon" key, same page. Recommended; falls back to the service key.
SUPABASE_ANON_KEY=your-anon-key

# Open Beauty Facts
OBF_API_BASE_URL=https://world.openbeautyfacts.org/api/v2

# Optional: enables reading an ingredient list from a photo (POST /api/analyze/image)
ANTHROPIC_API_KEY=
